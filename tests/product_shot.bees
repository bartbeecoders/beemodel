# The v0.6 product-shot benchmark: a studio scene with the materials Hive
# handles (a clear-coated paint, brushed gold, glass, an emissive strip and
# a noise-bumped plinth) under the studio sky and sun. fakewl renders it at
# a resolution and sample count scaled to the machine (see product_shot()).
delete("Cube")
delete("Light")
delete("Camera")
add("plane", "Floor")
scale("Floor", 40)
f = material("Floor")
matset(f, "base", 0.62, 0.6, 0.57)
matset(f, "roughness", 0.55)
assign("Floor", f)
add("cylinder", "Plinth", 0, 0.4, 0)
scale("Plinth", 2.2, 0.4, 2.2)
p = material("Stone")
n = node(p, "noise", 2.5, 5, 0.55)
r = node(p, "ramp")
link(p, n, r, 1)
nodeset(p, r, 2, 0.32, 0.31, 0.3)
nodeset(p, r, 3, 0.72, 0.7, 0.66)
socket(p, "base", r)
b = node(p, "bump", 1.5, 0.15)
link(p, n, b, 1)
socket(p, "normal", b)
matset(p, "roughness", 0.7)
assign("Plinth", p)
add("sphere", "Paint", -0.9, 1.6, 0.3)
scale("Paint", 0.8)
c = material("Car paint")
matset(c, "base", 0.55, 0.02, 0.04)
matset(c, "roughness", 0.35)
matset(c, "clearcoat", 1)
assign("Paint", c)
add("torus", "Ring", 0.9, 1.45, -0.2)
rotate("Ring", rad(70), rad(20), 0)
g = material("Gold")
matset(g, "base", 1, 0.766, 0.336)
matset(g, "metallic", 1)
matset(g, "roughness", 0.22)
assign("Ring", g)
add("sphere", "Glass", 0.6, 1.25, 1.2)
scale("Glass", 0.45)
q = material("Glass")
matset(q, "transmission", 1)
matset(q, "roughness", 0.02)
matset(q, "ior", 1.5)
assign("Glass", q)
add("cube", "Strip", 0, 3.2, -2.6)
scale("Strip", 2.2, 0.08, 0.08)
e = material("Light strip")
matset(e, "emission", 1, 0.92, 0.8)
matset(e, "strength", 12)
assign("Strip", e)
add("camera", "Cam", 0, 3.6, 9.5)
rotate("Cam", rad(-15), 0, 0)
