delete("Cube")
add("sphere", "A")
modifier("A", "subsurf")
modset("A", 0, "levels", 3)
modapply("A", 0)
modifier("A", "subsurf")
modset("A", 0, "levels", 2)
t = clock()
n = efaces("A")
b = clock() - t
vmove("A", 0, 0, 1.2, 0)
t = clock()
n = efaces("A")
u = clock() - t
print("subsurf_build ", b, " ", n)
print("subsurf_update ", u)
modremove("A", 0)
modifier("A", "subsurf")
modset("A", 0, "levels", 1)
modapply("A", 0)
t = clock()
k = analyze("A", "boundary")
print("analyze ", clock() - t, " ", faces("A"))
select("A")
t = clock()
op("mesh.repair")
print("repair ", clock() - t)
add("cube", "B")
scale("B", 2, 0.3, 2)
t = clock()
boolean("A", "B", "difference")
print("boolean ", clock() - t, " ", manifold("A"))
