#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Crate" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 2
        double3 xformOp:translate = (0, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding:physics = </World/Looks/Slippery>

        def Mesh "Box" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
            point3f[] points = [(-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5), (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5)]
        }
    }

    def Xform "Lid" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0, 2.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Lid" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.5
            uniform token physics:approximation = "boundingCube"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
            point3f[] points = [(-0.5, -0.05, 0.5), (0.5, -0.05, 0.5), (-0.5, 0.05, 0.5), (0.5, 0.05, 0.5), (-0.5, 0.05, -0.5), (0.5, 0.05, -0.5), (-0.5, -0.05, -0.5), (0.5, -0.05, -0.5)]
        }
    }

    def Xform "Shelf" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        double3 xformOp:translate = (3, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Shelf"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
        }
    }

    def Xform "Drawer" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (3, 1.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Drawer"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-0.3, 0, -0.3), (0.3, 0, -0.3), (0.3, 0, 0.3), (-0.3, 0, 0.3)]
        }
    }

    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "Hinge"
        {
            rel physics:body0 = </World/Crate>
            rel physics:body1 = </World/Lid>
            uniform token physics:axis = "Z"
            point3f physics:localPos0 = (0.5, 0.55, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }

        def PhysicsPrismaticJoint "Slide" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            rel physics:body0 = </World/Shelf>
            rel physics:body1 = </World/Drawer/Drawer>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0, 0.2, 0)
            float physics:lowerLimit = -0.5
            float physics:upperLimit = 0.5
        }

        def PhysicsFixedJoint "Off"
        {
            bool physics:jointEnabled = 0
            rel physics:body0 = </World/Crate>
            rel physics:body1 = </World/Shelf>
        }
    }

    def Scope "Looks"
    {
        def Material "Slippery" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.6
        }
    }
}
