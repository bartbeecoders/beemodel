# Material Gallery — BeeModel v1.0 demo
# All 20 material presets, each on its own shape on a plinth, in a curved gallery:
# the metals (gold, silver, copper, chrome, aluminium), the dielectrics (plastic,
# rubber, ceramic, clay, car paint, skin), the clear ones (glass, frosted glass,
# water), a light (emissive) and the five procedural ones built from node graphs
# (wood, marble, concrete, fabric, leather). The shapes are signed-distance
# models: a sphere, a rounded box, a torus and a blended knot of the two.
# The camera walks along the row and back.
# Run: script.run <this file>  (it replaces the scene), then press Space.

while count() > 0 { delete(name(0)) }
sclear()
op("anim.range", "1 300 30")

fn preset(i) {
    if i == 0 { return "gold" } else if i == 1 { return "silver" } else if i == 2 { return "copper" }
    if i == 3 { return "chrome" } else if i == 4 { return "aluminium" } else if i == 5 { return "plastic" }
    if i == 6 { return "rubber" } else if i == 7 { return "ceramic" } else if i == 8 { return "clay" }
    if i == 9 { return "car_paint" } else if i == 10 { return "skin" } else if i == 11 { return "glass" }
    if i == 12 { return "frosted_glass" } else if i == 13 { return "water" } else if i == 14 { return "emissive" }
    if i == 15 { return "wood" } else if i == 16 { return "marble" } else if i == 17 { return "concrete" }
    if i == 18 { return "fabric" }
    return "leather"
}

# four shapes, meshed once each and used in turn
s0 = ssphere(0.5)
s1 = sbox(0.75, 0.75, 0.75, 0.12)
s2 = srot(storus(0.34, 0.13), 70deg, 0, 0)
s3 = sunion(ssphere(0.36), srot(storus(0.38, 0.1), 0, 0, 90deg), 0.08)
fn shape(n, k) {
    if k == 0 { return smesh(n, s0, 72) } else if k == 1 { return smesh(n, s1, 72) }
    if k == 2 { return smesh(n, s2, 96) }
    return smesh(n, s3, 96)
}

material("Plinth"); op("material.preset", "concrete Plinth")
m = material("Floor"); matset(m, "base", 0.05, 0.05, 0.06); matset(m, "roughness", 0.25)
m = material("Wall"); matset(m, "base", 0.16, 0.17, 0.2); matset(m, "roughness", 0.9)

# the row: an arc of 20 plinths, 1.9 m apart, each with its preset on a shape
R = 12
for i in 0..20 {
    a = (i - 9.5) * 9deg
    x = sin(a) * R
    z = R - cos(a) * R
    p = add("cylinder", "Plinth" + i, x, 0.45, z); scale(p, 0.5, 0.45, 0.5); assign(p, "Plinth")
    mname = preset(i)
    material(mname); op("material.preset", preset(i) + " " + mname)
    o = shape("Exhibit " + mname, i % 4)
    move(o, x, 1.45, z)
    rotate(o, 0, a, 0)
    assign(o, mname)
    key("Exhibit " + mname + ":ry", 1, a, "linear")
    key("Exhibit " + mname + ":ry", 300, a + 2 * pi, "linear")
}
matset("emissive", "strength", 6)
print("materials", 20, "exhibits", count())

# indoors: a dark polished floor, a curved wall behind the row, a ceiling, and
# a lamp over every other plinth
g = add("plane", "Floor", 0, 0, 6); scale(g, 30); assign(g, "Floor")
c = add("plane", "Ceiling", 0, 4.2, 6); scale(c, 30); rotate(c, pi, 0, 0); assign(c, "Wall")
for i in 0..14 {
    a = (i - 6.5) * 14deg
    w = add("cube", "Wall" + i, sin(a) * (R - 2.6), 2.1, R - cos(a) * (R - 2.6)); scale(w, 1.35, 2.1, 0.1); rotate(w, 0, a, 0); assign(w, "Wall")
}
w = add("cube", "Wall Left", -14, 2.1, 4); scale(w, 0.1, 2.1, 17); assign(w, "Wall")
w = add("cube", "Wall Right", 14, 2.1, 4); scale(w, 0.1, 2.1, 17); assign(w, "Wall")
w = add("cube", "Wall Back", 0, 2.1, -13); scale(w, 14, 2.1, 0.1); assign(w, "Wall")
w = add("cube", "Wall Far", 0, 2.1, 21); scale(w, 14, 2.1, 0.1); assign(w, "Wall")
for i in 0..10 {
    a = (i * 2 + 0.5 - 9.5) * 9deg
    add("light", "Lamp" + i, sin(a) * (R + 0.4), 3.6, R - cos(a) * (R + 0.4)); op("light.set", "power 0.06")
}
op("world.strength", 0.05)

# the walk: from the metals to the procedural end and back to the middle
fn shot(f, x, y, z, tx, ty, tz) {
    dx = x - tx; dy = y - ty; dz = z - tz
    key("Cam:x", f, x); key("Cam:y", f, y); key("Cam:z", f, z)
    key("Cam:ry", f, atan2(dx, dz)); key("Cam:rx", f, -atan2(dy, sqrt(dx * dx + dz * dz)))
}
add("camera", "Cam", 0, 2, -8); set("Cam", "lens", 28)
shot(1, -10.5, 2.1, 1.0, -11.1, 1.3, 7.4)
shot(100, -2, 1.9, -2.8, -4.5, 1.3, 1.2)
shot(200, 6.5, 1.9, -2.0, 9.5, 1.3, 3.0)
shot(300, 0, 3.2, -9.5, 0, 1.2, 4)
select("Cam"); op("camera.set", "active")
view(0, 15, 14, 0, 1.3, 3)
frame(1)
