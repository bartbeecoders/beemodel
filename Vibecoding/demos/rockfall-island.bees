# Rockfall Island — BeeModel v0.18/v0.19 demo
# An island landscape (Add › Landscape › Island: generated, eroded, auto-painted)
# with its sea. Boulders tumble down the heightfield collider, smash a glued
# stone watchtower, and land in the water, where wooden crates bob.
# Run: script.run <this file>, then press Space.

while count() > 0 { delete(name(0)) }
op("anim.range", "1 300 30")
op("rigid.world", "gravity 0 -9.81 0 rate 120 iterations 10 substeps 4")

# the island: taller than the preset, painted by slope and height
op("landscape.add", "island size 120 seed 3")
L = "Landscape"
select(L)
op("landscape.layer", "set 0 height 62")
op("landscape.paint", "add sand colour 0.78 0.69 0.5")
op("landscape.paint", "add grass colour 0.22 0.42 0.12 friction 0.7")
op("landscape.paint", "add rock colour 0.36 0.33 0.3 friction 0.8")
op("landscape.paint", "add snow colour 0.95 0.95 0.97")
op("landscape.paint_auto")
print("island", landscape(L, 1), "m, heights", landscape(L, 3), "to", landscape(L, 4))

fn mat(n, r, g, b, rough, metal) {
    m = material(n); matset(m, "base", r, g, b); matset(m, "roughness", rough); matset(m, "metallic", metal); return m
}
mat("Boulder", 0.24, 0.22, 0.21, 0.9, 0)
mat("Tower Stone", 0.72, 0.68, 0.6, 0.85, 0)
mat("Crate Wood", 0.62, 0.42, 0.22, 0.7, 0)

# find the summit: the highest of a coarse grid of samples
seed(11)
best = -100
SX = 0
SZ = 0
for i in -20..21 { for j in -20..21 {
    h = height(L, i * 2.5, j * 2.5)
    if h != nil and h > best { best = h; SX = i * 2.5; SZ = j * 2.5 } } }
print("summit", SX, best, SZ)

# a watchtower half way down the slope towards +x (towards the camera's first view)
TX = SX + 13
TZ = SZ + 3
TY = height(L, TX, TZ)
# a level pad for it: a Flatten layer on the landscape's stack
select(L)
op("landscape.layer", "add flatten height " + TY + " at " + TX + " " + TZ + " 7")
op("landscape.paint_auto")
select(L); op("rigid.add", "passive mesh")
t = add("cylinder", "Tower", TX, TY + 5.02, TZ); scale(t, 2.2, 5, 2.2); assign(t, "Tower Stone")
select(t); op("object.shatter", "bricks counts 4 10 4 glue 400000 density 2200 inner 0.5 0.47 0.42")
print("tower", shinfo(0), "pieces,", shinfo(7), "glue joints")

# boulders, let go round the summit a little after one another (higher = later)
for i in 0..28 {
    a = rand() * 2 * pi
    r = 1 + rand() * 6
    x = SX - 1 + cos(a) * r
    z = SZ + sin(a) * r
    h = height(L, x, z)
    if h == nil { h = 0 }
    s = 1.0 + rand() * 1.4
    sy = s * (0.7 + rand() * 0.3)
    sz = s * (0.8 + rand() * 0.4)
    b = add("sphere", "Boulder " + i, x, h + s + 2 + i * 1.5, z)
    scale(b, s, sy, sz); rotate(b, rand() * 3, rand() * 3, 0)
    assign(b, "Boulder")
    # granite: 2700 kg/m3, so they sink when they reach the sea
    select(b); op("rigid.add", "active hull material stone velocity 6 0 0 mass " + round(2700 * 4 / 3 * pi * s * sy * sz))
}

# crates in the sea off the +x shore: pine floats (600 kg/m3)
SH = TX
while height(L, SH, TZ) != nil and height(L, SH, TZ) > -1.5 { SH += 1 }
print("shore at x", SH)
for i in 0..12 {
    x = SH + 6 + (i % 4) * 6 + rand() * 2
    z = TZ - 10 + floor(i / 4) * 8 + rand() * 2
    c = add("cube", "Crate " + i, x, 4 + rand() * 6, z)
    scale(c, 1.2); rotate(c, rand(), rand(), rand())
    assign(c, "Crate Wood")
    select(c); op("rigid.add", "active box material wood mass " + round(600 * 13.8))
}

# camera: a sweeping orbit round the island, closing in on the tower
cam = add("camera", "Cam", 150, 60, 0)
fn camkey(f, ang, r, y, tx, ty, tz) {
    x = tx + cos(ang) * r
    z = tz + sin(ang) * r
    dx = tx - x; dy = ty - y; dz = tz - z
    key("Cam:x", f, x); key("Cam:y", f, y); key("Cam:z", f, z)
    key("Cam:ry", f, atan2(-dx, -dz)); key("Cam:rx", f, atan2(dy, sqrt(dx * dx + dz * dz)))
}
camkey(1, 40deg, 175, 75, 0, 0, 0)
camkey(80, 25deg, 48, TY + 14, TX, TY + 5, TZ)
camkey(170, -20deg, 40, TY + 8, TX + 4, TY, TZ)
camkey(300, -35deg, 75, 18, SH + 8, 0, TZ)
add("light", "Sun", 80, 120, 60)
view(40, 25, 190, 0, 5, 0)
frame(1)
