// BeeModel - the Hive path tracer on the GPU (beemodel-gpu).
//
// A line-for-line port of hive_pt.s / hive.s (built twice: pt, and ptg with
// GRAPHS, which also evaluates the materials' shader graphs): the same camera rays, the
// same xorshift64* streams (hash of pixel, sample and seed), the same BVH4
// (the CPU's nodes, uploaded as they are), BSDF, lights and MIS. A path
// therefore takes the same decisions as on the CPU until float rounding
// differs somewhere, so the images agree within noise. Scenes this does not
// cover (shader graphs, an HDRI world) stay on the CPU (src/gpu.s decides).
//
// One invocation per pixel adds `count` samples into the accumulators.
//
// The live viewport (Rendered shading, src/live.s) uses the same kernel from
// its own slot, with flags in cam[14]: 1 live (the accumulators stay on the
// GPU, the first pass overwrites them, and each pass leaves the pixel's mean
// in m2 as XRGB); 2 raycast (one ray a pixel: the lights' direct light with
// hard shadows, the sky with short-range occlusion, mirrors and glass
// followed; drawn while the view moves); 4 denoise (the samples also sum
// the first hit's albedo, normal and depth and the luminance moments, and
// leave the filter's input instead of XRGB); bits 8-11 a denoise stage
// (count 0): 1 the variance blurred, 2-6 the a-trous passes, the last one
// leaving XRGB (denoise.s's filter, the same steps).
//
// RTX (built as ptr and ptgr, Vulkan 1.2): trace() walks the helper's
// acceleration structures (binding 20: one instance of the triangles, one of
// the balls as boxes) with a ray query instead of the BVH4. Every triangle
// is non-opaque, so each candidate comes here and tri_hit / sph_hit decide
// it with the same arithmetic as the BVH path: the hardware only finds them.
#version 460
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_GOOGLE_include_directive : require
#ifdef RTX
#extension GL_EXT_ray_query : require
#endif

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer Params {
    uint w, h, spp, count;          // the first sample's number, how many
    uint seed, nslots, npoints, nl;
    uint ntri, root, debug, cut;    // cut: masked / translucent / one-sided in it
    float cam[16];                  // origin, right, up, forward, tan_h; [13]: the balls,
                                    //  [14]: live flags, [15]: 1 they move (motion blur)
    float points[64 * 16];          // light objects: position, colour * power, type, size,
                                    //  direction, cos (sun / spot outer), area axis, inner cos
    float lut[256];                 // sRGB byte -> linear (srgb_to_lin)
} P;
layout(std430, binding = 1) readonly buffer TV { float tv[]; };      // v0 e1 e2
layout(std430, binding = 2) readonly buffer TN { float tn[]; };      // corner normals
layout(std430, binding = 3) readonly buffer TM { uint tm[]; };       // material
layout(std430, binding = 4) readonly buffer TC { uint tvc[]; };      // vertex colours
layout(std430, binding = 5) readonly buffer MA { float mats[]; };    // records: 1024 words each
layout(std430, binding = 6) readonly buffer ND { float nodes[]; };   // 32 words each
layout(std430, binding = 7) readonly buffer LC { float lcdf[]; };
layout(std430, binding = 8) readonly buffer LT { uint ltri[]; };
layout(std430, binding = 9) readonly buffer LS { float lsel[]; };
layout(std430, binding = 10) buffer AC { float accum[]; };           // w h 3
layout(std430, binding = 11) buffer AX { float aux[]; };             // w h 7
layout(std430, binding = 12) buffer M2 { uint m2[]; };               // w h: f32 bits (live: XRGB)
layout(std430, binding = 13) readonly buffer TO { float to_[]; };    // object-space v0 e1 e2
layout(std430, binding = 14) readonly buffer TU { float tuv[]; };    // UVs (u0 NaN: none)
layout(std430, binding = 15) readonly buffer IM { uint img[]; };     // 1024 x (texel offset, w, h, fmt), texels
layout(std430, binding = 16) buffer FL { float film[]; };            // w h 4: a film with alpha (flag 16)
layout(std430, binding = 17) readonly buffer EV { float envimg[]; };  // (H3)
layout(std430, binding = 18) readonly buffer EC { float envcdf[]; };  // (H3)
layout(std430, binding = 19) readonly buffer SP { float sph[]; };     // (H6)
#ifdef RTX
layout(binding = 20) uniform accelerationStructureEXT tlas;            // (H10)
#endif

const float PI = 3.14159265;
const float INV_PI = 0.31830989;
const float TWO_PI = 6.28318531;
const float EPS = 1.0e-4;
const float TINY = 1.0e-8;
const float AMIN = 0.0004;
const float BIG = 1.0e30;
const int MAX_DEPTH = 12;
const vec3 SKY_ZENITH = vec3(0.34, 0.46, 0.74);
const vec3 SKY_HORIZON = vec3(0.72, 0.74, 0.78);
const vec3 SKY_GROUND = vec3(0.20, 0.19, 0.17);
const vec3 SUN_DIR = vec3(0.5246, 0.7343, 0.4302);
const float SUN_COS = 0.99996192;
const vec3 SUN_RAD = vec3(4100.0, 3950.0, 3700.0);
const float SUN_PDF = 4181.5;
const vec3 LUMW = vec3(0.2126, 0.7152, 0.0722);

uint64_t rng;
bool g_vcol = false;                    // the graph read the vertex colour (no tint after)

float rnd() {
    uint64_t x = rng;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    rng = x;
    x *= 0x2545F4914F6CDD1DUL;
    float r = float(uint(x >> 40)) * 5.9604645e-8;
    return min(r, 0.99999994);
}

float lum(vec3 c) { return c.x * 0.2126 + c.y * 0.7152 + c.z * 0.0722; }

vec3 unit3(vec3 v, out float len) {
    len = sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
    if (len > 0.0) v *= 1.0 / len;
    return v;
}
vec3 unit3(vec3 v) { float l; return unit3(v, l); }

void onb(vec3 n, out vec3 t, out vec3 b) {
    float s = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -(1.0 / (s + n.z));
    float bb = n.x * n.y * a;
    t = vec3(n.x * n.x * a * s + 1.0, bb * s, -(n.x * s));
    b = vec3(bb, n.y * n.y * a + s, -n.y);
}

vec3 local_to_world(vec3 l, vec3 t, vec3 b, vec3 n) { return t * l.x + b * l.y + n * l.z; }

vec2 sincos_2pi(float u) { float a = u * TWO_PI; return vec2(sin(a), cos(a)); }

// ---- the scene -------------------------------------------------------------
const uint CATCH = 0x40000000u;         // tm: a shadow catcher's triangle (HV_CATCH)
// spheres (particles drawn as balls, hive.s hv_sp): primitives from ntri on,
//   12 floats each (SP_*: centre, radius, material + 1, colour, velocity)
const uint SPW = 12u;
uint NSPH() { return floatBitsToUint(P.cam[13]); }
// liquids' surfaces (H13): fields after the balls, primitives from NTS() on
uint NFLD = 0u;                         // (main: binding 19's header)
uint NTS() { return P.ntri + NSPH(); }
bool is_fld(uint t) { return t >= NTS(); }
bool is_sph(uint t) { return t >= P.ntri && t < NTS(); }
uint sph_o(uint t) { return (t - P.ntri) * SPW; }
// motion blur: the sample's time in the shutter, from its middle (-0.5 .. 0.5;
//   0 without), and where a ball is then: c + v t (v: its movement while the
//   shutter is open), rounded as hive_pt.s's SPC
float rtime = 0.0;
bool mblur() { return floatBitsToUint(P.cam[15]) != 0u; }
vec3 sph_move(uint o, vec3 c) { precise vec3 m = vec3(sph[o + 6u], sph[o + 7u], sph[o + 8u]) * rtime; precise vec3 p = m + c; return p; }
vec3 sph_c(uint t) {
    uint o = sph_o(t);
    vec3 c = vec3(sph[o], sph[o + 1u], sph[o + 2u]);
    return rtime != 0.0 ? sph_move(o, c) : c;
}
float sph_r(uint t) { return sph[sph_o(t) + 3u]; }
uint fld_rec(uint t) { return NSPH() * SPW + 4u + (t - NTS()) * 32u; }
uint tmat(uint t) {
    if (is_fld(t)) return floatBitsToUint(sph[fld_rec(t) + 7u]);
    return is_sph(t) ? floatBitsToUint(sph[sph_o(t) + 4u]) & ~CATCH : tm[t] & ~CATCH;
}
bool has_vcol(uint t) { return is_fld(t) ? false : is_sph(t) ? floatBitsToUint(sph[sph_o(t) + 5u]) != 0u : tvc[t * 3u] != 0u; }
bool is_catch(uint t) { return t < P.ntri && (tm[t] & CATCH) != 0u; }
vec3 tv3(uint t, uint k) { uint o = t * 9u + k * 3u; return vec3(tv[o], tv[o + 1u], tv[o + 2u]); }
vec3 tn3(uint t, uint k) { uint o = t * 9u + k * 3u; return vec3(tn[o], tn[o + 1u], tn[o + 2u]); }

struct Ray { vec3 o; vec3 d; float tmax; float t; int tri; float u; float v; };
bool skipc = false;                     // trace: shadow catchers' triangles let through

bool tri_hit(uint t, inout Ray r, out float tt, out float uu, out float vv) {
    vec3 v0 = tv3(t, 0u), e1 = tv3(t, 1u), e2 = tv3(t, 2u);
    precise vec3 p = vec3(r.d.y * e2.z - r.d.z * e2.y, r.d.z * e2.x - r.d.x * e2.z, r.d.x * e2.y - r.d.y * e2.x);
    precise float det = e1.x * p.x + e1.y * p.y + e1.z * p.z;
    if (!(abs(det) > 1.0e-12)) return false;
    float inv = 1.0 / det;
    precise vec3 s = r.o - v0;
    precise float u = (p.x * s.x + p.y * s.y + p.z * s.z) * inv;
    if (u < 0.0 || u > 1.0) return false;
    precise vec3 q = vec3(s.y * e1.z - s.z * e1.y, s.z * e1.x - s.x * e1.z, s.x * e1.y - s.y * e1.x);
    precise float v = (r.d.x * q.x + r.d.y * q.y + r.d.z * q.z) * inv;
    if (v < 0.0 || u + v > 1.0) return false;
    precise float d = (q.x * e2.x + q.y * e2.y + q.z * e2.z) * inv;
    if (!(d > 1.0e-4)) return false;
    tt = d; uu = u; vv = v;
    return true;
}

// o + d t, rounded as the CPU does (no fused multiply-add; a function of its
//   own: precise in trace_path makes glslang take tens of gigabytes)
vec3 hit_point(Ray r) { precise vec3 p = r.d * r.t + r.o; return p; }

// a sphere: the nearer crossing past epsilon (from inside, the far one), from
//   the closest approach: k = (oc . d) / d^2, l = oc - k d, h = r^2 - l^2,
//   t = -k -+ sqrt(h / d^2) (b^2 - ac loses most of its digits for small, far
//   balls); hive.s sph_hit, step for step
bool sph_hit(uint t, inout Ray r, out float tt) {
    uint o = sph_o(t);
    precise vec3 oc = r.o - sph_c(t);
    precise float a = r.d.x * r.d.x + r.d.y * r.d.y + r.d.z * r.d.z;
    if (!(a > 1.0e-12)) return false;
    float inv = 1.0 / a;
    precise float k = (oc.x * r.d.x + oc.y * r.d.y + oc.z * r.d.z) * inv;
    precise vec3 l = oc - vec3(k * r.d.x, k * r.d.y, k * r.d.z);
    precise float rr = sph[o + 3u] * sph[o + 3u];
    precise float h = rr - (l.x * l.x + l.y * l.y + l.z * l.z);
    if (h < 0.0) return false;
    precise float sq = sqrt(h * inv);
    precise float t0 = -(k + sq);
    if (!(t0 > 1.0e-4)) {
        t0 = sq - k;
        if (!(t0 > 1.0e-4)) return false;
    }
    tt = t0;
    return true;
}

// one axis of the 4-wide box test (lanes: the node's four children)
void slab(uint base, float o, float iv, inout vec4 tn4, inout vec4 tf4) {
    vec4 lo = vec4(nodes[base], nodes[base + 1u], nodes[base + 2u], nodes[base + 3u]);
    vec4 hi = vec4(nodes[base + 4u], nodes[base + 5u], nodes[base + 6u], nodes[base + 7u]);
    bool neg = iv < 0.0;
    precise vec4 tnear = ((neg ? hi : lo) - vec4(o)) * iv;
    precise vec4 tfar = ((neg ? lo : hi) - vec4(o)) * iv;
    tn4 = max(tn4, tnear);
    tf4 = min(tf4, tfar);
}

// ---- a liquid's surface as its field (H13) -----------------------------------
// binding 19 after the balls: how many fields, then a record each (32 floats:
//   origin, spacing; nx ny nz, material + 1; the grid's low corner, where its
//   values start; its high corner, where its bricks start; bricks a side; the
//   emitter's inverse matrix, 3 rows), each one's values ((z ny + y) nx + x:
//   below 0 inside, the surface at 0) and each 8^3 brick's smallest and
//   largest value. Rays march it a cell a step, past bricks all on their
//   side; the step that crosses 0 is halved six times, then interpolated.
struct Fld { vec3 o; float sp; uvec3 n; vec3 lo; uint doff; vec3 hi; uint boff; uvec3 nb; };
Fld fld_get(uint t) {
    uint r = fld_rec(t);
    Fld f;
    f.o = vec3(sph[r], sph[r + 1u], sph[r + 2u]); f.sp = sph[r + 3u];
    f.n = uvec3(floatBitsToUint(sph[r + 4u]), floatBitsToUint(sph[r + 5u]), floatBitsToUint(sph[r + 6u]));
    f.lo = vec3(sph[r + 8u], sph[r + 9u], sph[r + 10u]); f.doff = floatBitsToUint(sph[r + 11u]);
    f.hi = vec3(sph[r + 12u], sph[r + 13u], sph[r + 14u]); f.boff = floatBitsToUint(sph[r + 15u]);
    f.nb = uvec3(floatBitsToUint(sph[r + 16u]), floatBitsToUint(sph[r + 17u]), floatBitsToUint(sph[r + 18u]));
    return f;
}
float fld_at(Fld f, vec3 p) {           // trilinear
    vec3 g = clamp((p - f.o) / f.sp, vec3(0.0), vec3(f.n - 1u));
    uvec3 i = min(uvec3(g), f.n - 2u);
    vec3 a = g - vec3(i);
    uint nx = f.n.x, nxy = f.n.x * f.n.y;
    uint b = f.doff + i.z * nxy + i.y * nx + i.x;
    vec4 z0 = vec4(sph[b], sph[b + 1u], sph[b + nx], sph[b + nx + 1u]);
    b += nxy;
    vec4 z1 = vec4(sph[b], sph[b + 1u], sph[b + nx], sph[b + nx + 1u]);
    vec4 c = mix(z0, z1, a.z);
    vec2 e = mix(c.xz, c.yw, a.x);
    return mix(e.x, e.y, a.y);
}
vec3 fld_normal(uint t, vec3 p) {       // the field's gradient: outward
    Fld f = fld_get(t);
    vec3 g = vec3(0.0);
    for (int k = 0; k < 6; k++) {       // (one fld_at: inlined once)
        vec3 e = vec3(0.0);
        e[k >> 1] = (k & 1) == 0 ? 0.5 * f.sp : -0.5 * f.sp;
        g[k >> 1] += (k & 1) == 0 ? fld_at(f, p + e) : -fld_at(f, p + e);
    }
    float l = length(g);
    return l > 1.0e-20 ? g / l : vec3(0.0, 1.0, 0.0);
}
// the nearest crossing of field primitive t before best (then best = it)
bool fld_hit(uint t, Ray r, inout float best) {
    Fld f = fld_get(t);
    vec3 iv = vec3(abs(r.d.x) > 1.0e-12 ? 1.0 / r.d.x : 1.0e30, abs(r.d.y) > 1.0e-12 ? 1.0 / r.d.y : 1.0e30,
                   abs(r.d.z) > 1.0e-12 ? 1.0 / r.d.z : 1.0e30);
    vec3 a0 = (f.lo - r.o) * iv, a1 = (f.hi - r.o) * iv;
    vec3 tn = min(a0, a1), tf = max(a0, a1);
    float dl = length(r.d);
    float stp = f.sp / dl;                               // a cell a step
    float ta = max(max(tn.x, tn.y), max(tn.z, 0.05 * stp));   // (off the surface it starts on)
    float tb = min(min(tf.x, tf.y), min(tf.z, best));
    if (!(ta < tb)) return false;
    bool ins = false;                   // one loop, one sample a turn (fld_at
    int mode = 0, k = 0;                //  is inlined once): 0 the start, 1
    float lo = ta, hi = ta, flo = 0.0, fhi = 0.0, tc = ta;  //  marching, 2 halving
    for (int it = 0; it < 4096; it++) {
        float fv = fld_at(f, r.o + r.d * tc);
        if (mode == 0) { ins = fv < 0.0; mode = 1; lo = tc; flo = fv; }
        else if (mode == 1) {
            if ((fv < 0.0) != ins) { hi = tc; fhi = fv; mode = 2; }
            else { if (tc >= tb) return false; lo = tc; flo = fv; }
        } else {
            if ((fv < 0.0) == ins) { lo = tc; flo = fv; } else { hi = tc; fhi = fv; }
            if (++k == 6) break;
        }
        if (mode == 2) { tc = 0.5 * (lo + hi); continue; }
        float tq = lo + 0.01 * stp;     // the brick just ahead: all on this side,
        vec3 g = (r.o + r.d * tq - f.o) / f.sp;                 //  past it; else a cell
        uvec3 bi = min(uvec3(max(g, vec3(0.0)) * 0.125), f.nb - 1u);
        uint bo = f.boff + ((bi.z * f.nb.y + bi.y) * f.nb.x + bi.x) * 2u;
        if (ins ? sph[bo + 1u] < 0.0 : sph[bo] > 0.0) {
            vec3 b0 = (f.o + vec3(bi * 8u) * f.sp - r.o) * iv;
            vec3 b1 = (f.o + vec3(min(bi * 8u + 8u, f.n - 1u)) * f.sp - r.o) * iv;
            vec3 bf = max(b0, b1);
            tc = max(min(min(bf.x, bf.y), bf.z), tq);
        } else tc = lo + stp;
        tc = min(tc, tb);
    }
    if (mode != 2) return false;
    float th = lo + (hi - lo) * clamp(flo / (flo - fhi), 0.0, 1.0);   // (then linear)
    if (!(th < best)) return false;
    best = th;
    return true;
}
// the fields after the triangles and balls (trace's last step)
bool fld_trace(inout Ray r, bool anyhit, float best, bool hit) {
    for (uint k = 0u; k < NFLD; k++) {
        uint t = NTS() + k;
        if (!fld_hit(t, r, best)) continue;
        r.tri = int(t); r.t = best; r.u = 0.0; r.v = 0.0;
        hit = true;
        if (anyhit) return true;
    }
    return hit;
}

// the nearest hit (any: the first closer than tmax)
#ifdef RTX
bool trace(inout Ray r, bool anyhit) {
    r.tri = -1;
    float best = r.tmax, hwbest = r.tmax;
    bool hit = false;
    if (P.ntri != 0u || NSPH() != 0u) {     // (none: the fields alone)
        rayQueryEXT q;
        rayQueryInitializeEXT(q, tlas, gl_RayFlagsNoneEXT, 0xffu, r.o, 0.0, r.d, r.tmax);
        while (rayQueryProceedEXT(q)) {
            uint t = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, false));
            bool tri = rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT;
            float tt, uu = 0.0, vv = 0.0;
            if (tri) {
                if (skipc && (tm[t] & CATCH) != 0u) continue;
                if (!tri_hit(t, r, tt, uu, vv)) continue;
            } else {
                t += P.ntri;
                if (!sph_hit(t, r, tt)) continue;
            }
            if (!(tt < best)) continue;
            if (tri) {
                rayQueryConfirmIntersectionEXT(q);
                hwbest = min(hwbest, rayQueryGetIntersectionTEXT(q, false));
            } else {
                if (tt > hwbest) continue;          // (past what the hardware holds)
                rayQueryGenerateIntersectionEXT(q, tt);
                hwbest = tt;
            }
            best = tt;
            r.tri = int(t); r.t = tt; r.u = uu; r.v = vv;
            hit = true;
            if (anyhit) { rayQueryTerminateEXT(q); return true; }
        }
    }
    return fld_trace(r, anyhit, best, hit);
}
#else
bool trace(inout Ray r, bool anyhit) {
    r.tri = -1;
    float ix = abs(r.d.x) > 1.0e-12 ? 1.0 / r.d.x : 1.0e30;
    float iy = abs(r.d.y) > 1.0e-12 ? 1.0 / r.d.y : 1.0e30;
    float iz = abs(r.d.z) > 1.0e-12 ? 1.0 / r.d.z : 1.0e30;
    uint stk[64];
    float stt[64];
    int sp = P.ntri == 0u && NSPH() == 0u ? 0 : 1;      // (none: the fields alone)
    stk[0] = P.root;
    float best = r.tmax;
    bool hit = false;
    while (sp > 0) {
        sp--;
        uint ref = stk[sp];
        if ((ref & 0x80000000u) == 0u) {
            vec4 tn4 = vec4(0.0), tf4 = vec4(best);
            uint nb = ref * 32u;
            slab(nb, r.o.x, ix, tn4, tf4);
            slab(nb + 8u, r.o.y, iy, tn4, tf4);
            slab(nb + 16u, r.o.z, iz, tn4, tf4);
            bvec4 in4 = lessThanEqual(tn4, tf4);
            if (!any(in4)) continue;
            int start = sp;
            for (int c = 0; c < 4; c++) {
                if (!in4[c]) continue;
                uint child = floatBitsToUint(nodes[nb + 24u + uint(c)]);
                float tc = tn4[c];
                int i = sp;
                while (i > start && !(stt[i - 1] >= tc)) {
                    stk[i] = stk[i - 1];
                    stt[i] = stt[i - 1];
                    i--;
                }
                stk[i] = child;
                stt[i] = tc;
                sp++;
            }
            if (sp >= 60) sp = 60;
        } else {
            if (ref == 0xffffffffu) continue;
            uint first = ref & 0x07ffffffu;
            uint end = first + ((ref >> 27) & 0xfu);
            bool sl = first >= P.ntri;          // (a leaf of spheres)
            for (uint t = first; t < end; t++) {
                float tt, uu, vv;
                if (sl) {
                    if (!sph_hit(t, r, tt)) continue;
                    uu = 0.0; vv = 0.0;
                } else {
                    if (skipc && (tm[t] & CATCH) != 0u) continue;
                    if (!tri_hit(t, r, tt, uu, vv)) continue;
                }
                if (!(tt < best)) continue;
                best = tt;
                r.tri = int(t); r.t = tt; r.u = uu; r.v = vv;
                hit = true;
                if (anyhit) return true;
            }
        }
    }
    return fld_trace(r, anyhit, best, hit);
}
#endif

// ---- the world: studio sky and sun -------------------------------------------
// ---- an HDRI world (env.s): the equirect image as rgb floats (binding 17);
//   binding 18: a header (w, h, the CDF's total, the rotation, the strength),
//   then the conditional CDF per row (w h), the row sums (h), the marginal (h)
bool env_on() { return (floatBitsToUint(P.cam[14]) & 32u) != 0u; }
uint ENV_W() { return floatBitsToUint(envcdf[0]); }
uint ENV_H() { return floatBitsToUint(envcdf[1]); }
const uint EH = 8u;                     // the header's floats
uint env_cond(uint i) { return EH + i; }
uint env_rows(uint y) { return EH + ENV_W() * ENV_H() + y; }
uint env_marg(uint y) { return EH + ENV_W() * ENV_H() + ENV_H() + y; }

// u = 0.5 + (atan2(x, -z) - rotation) / 2 pi (wrapped), v = theta / pi
vec3 env_dir_uv(vec3 d) {
    float phi = atan(d.x, -d.z);
    float ct = clamp(d.y, -1.0, 1.0);
    float st = sqrt(max(1.0 - ct * ct, 0.0));
    float th = atan(st, ct);
    float u = (phi - envcdf[3]) * 0.15915494 + 0.5;
    u -= floor(u);
    return vec3(u, th * INV_PI, st);
}

vec3 env_uv_dir(float u, float v) {
    float phi = u * TWO_PI - PI + envcdf[3];
    float th = v * PI;
    float st = sin(th), ctt = cos(th);
    return vec3(sin(phi) * st, ctt, -(cos(phi) * st));
}

vec3 env_texel(uint x, uint y) { uint o = (y * ENV_W() + x) * 3u; return vec3(envimg[o], envimg[o + 1u], envimg[o + 2u]); }

vec3 env_rad(vec3 d) {                  // bilinear: u wraps, v clamps
    vec3 uv = env_dir_uv(d);
    int W = int(ENV_W()), H = int(ENV_H());
    float fx = uv.x * float(W) - 0.5;
    float fy = max(uv.y * float(H) - 0.5, 0.0);
    float x0f = floor(fx);
    fx -= x0f;
    int x0 = int(x0f) % W;
    if (x0 < 0) x0 += W;
    int y0 = int(fy);
    fy -= float(y0);
    y0 = min(y0, H - 1);
    int y1 = min(y0 + 1, H - 1);
    int x1 = x0 + 1 >= W ? 0 : x0 + 1;
    vec3 a = env_texel(uint(x0), uint(y0)), b = env_texel(uint(x1), uint(y0));
    vec3 c = env_texel(uint(x0), uint(y1)), e = env_texel(uint(x1), uint(y1));
    vec3 top = (b - a) * fx + a;
    vec3 bot = (e - c) * fx + c;
    return ((bot - top) * fy + top) * envcdf[4];
}

uint env_bsearch(uint base, uint n, float u) {
    uint lo = 0u, hi = n;
    while (lo < hi) {
        uint m = (lo + hi) >> 1;
        if (u < envcdf[base + m]) hi = m; else lo = m + 1u;
    }
    return min(lo, n - 1u);
}

float env_pdf_px(uint x, uint y, float st) {
    uint i = env_cond(y * ENV_W() + x);
    float f = envcdf[i];
    if (x != 0u) f -= envcdf[i - 1u];
    f *= envcdf[env_rows(y)];
    f /= envcdf[2];
    f *= float(ENV_W()) * float(ENV_H());
    return f / max(st * 19.7392088, 1.0e-12);
}

float env_pdf(vec3 d) {
    vec3 uv = env_dir_uv(d);
    uint x = uint(clamp(int(uv.x * float(ENV_W())), 0, int(ENV_W()) - 1));
    uint y = uint(clamp(int(uv.y * float(ENV_H())), 0, int(ENV_H()) - 1));
    return env_pdf_px(x, y, uv.z);
}

float env_sample(float u0, float u1, float u2, float u3, out vec3 dir) {
    uint y = env_bsearch(env_marg(0u), ENV_H(), u0);
    uint x = env_bsearch(env_cond(y * ENV_W()), ENV_W(), u1);
    float u = (float(x) + u2) / float(ENV_W());
    float v = (float(y) + u3) / float(ENV_H());
    dir = env_uv_dir(u, v);
    return env_pdf_px(x, y, sin(v * PI));
}

vec3 sky_rad(vec3 d) {
    if (P.debug == 3u) return vec3(0.5);
    if (env_on()) return env_rad(d);
    if (d.y > 0.0) {
        float s = sqrt(d.y);
        return (SKY_ZENITH - SKY_HORIZON) * s + SKY_HORIZON;
    }
    return SKY_GROUND;
}

bool in_sun(vec3 d) {
    if (P.debug >= 2u || env_on()) return false;
    return dot(d, SUN_DIR) > SUN_COS;
}

// ---- materials --------------------------------------------------------------
// the values from +32 (floats 8..): base 8-10, metal 11, rough 12, specular 13,
// ior 14, transmission 15, emission 16-18, strength 19, coat 20, coat rough 21
struct Mat { vec3 base; float metal, rough, spec, ior, trans; vec3 emit; float strength, coat, crough; };

Mat mat_of(uint t) {
    Mat m;
    uint i = tmat(t);
    if (i == 0u) {
        m.base = vec3(0.8); m.metal = 0.0; m.rough = 0.5; m.spec = 0.5; m.ior = 1.45; m.trans = 0.0;
        m.emit = vec3(0.0); m.strength = 0.0; m.coat = 0.0; m.crough = 0.03;
        return m;
    }
    uint o = i * 1024u;
    m.base = vec3(mats[o + 8u], mats[o + 9u], mats[o + 10u]);
    m.metal = mats[o + 11u]; m.rough = mats[o + 12u]; m.spec = mats[o + 13u];
    m.ior = mats[o + 14u]; m.trans = mats[o + 15u];
    m.emit = vec3(mats[o + 16u], mats[o + 17u], mats[o + 18u]);
    m.strength = mats[o + 19u]; m.coat = mats[o + 20u]; m.crough = mats[o + 21u];
    return m;
}

vec3 vcol_lin3(uint t, float u, float v);
vec3 prim_vcol(uint t, float u, float v) {      // a sphere: its one colour
    if (!is_sph(t)) return vcol_lin3(t, u, v);
    uint c = floatBitsToUint(sph[sph_o(t) + 5u]);
    return vec3(P.lut[(c >> 16) & 0xffu], P.lut[(c >> 8) & 0xffu], P.lut[c & 0xffu]);
}
vec3 vcol_lin3(uint t, float u, float v) {
    float wt[3] = float[3](1.0 - u - v, u, v);
    vec3 out_c;
    for (int ch = 0; ch < 3; ch++) {
        float acc = 0.0;
        for (int k = 0; k < 3; k++) {
            uint c = tvc[t * 3u + uint(k)];
            uint byte = (c >> uint(16 - ch * 8)) & 0xffu;
            acc = P.lut[byte] * wt[k] + acc;
        }
        out_c[ch] = acc;
    }
    return out_c;
}

#ifdef GRAPHS
#include "graph.glsl"
// graph_shade: the graph at (t, u, v): Mat values over, the normal (unless
//   only the coverage is wanted), the opacity and mask (-1: not driven)
void graph_shade(uint m, uint t, float u, float v, bool cover, inout Mat mt, inout vec3 ns,
                 out float alpha, out float mask) {
    if (is_fld(t)) {                    // a field: the point in its emitter's
        uint r = fld_rec(t) + 20u;      //  space (the mesh's), no edges, box UVs
        vec4 p4 = vec4(G_WP, 1.0);
        S_P0 = vec3(dot(vec4(sph[r], sph[r + 1u], sph[r + 2u], sph[r + 3u]), p4),
                    dot(vec4(sph[r + 4u], sph[r + 5u], sph[r + 6u], sph[r + 7u]), p4),
                    dot(vec4(sph[r + 8u], sph[r + 9u], sph[r + 10u], sph[r + 11u]), p4));
        S_E1 = vec3(0.0); S_E2 = vec3(0.0);
        vec3 tt, bb;
        onb(ns, tt, bb);
        float sp = sph[fld_rec(t) + 3u];
        S_PU = tt * sp; S_PV = bb * sp;
        G_VC = vec3(1.0);
        box_uv();
    } else if (is_sph(t)) {             // a sphere: the unit ball's point, no
        S_P0 = (G_WP - sph_c(t)) * (1.0 / sph_r(t));    //  edges, its tangents x r,
        S_E1 = vec3(0.0); S_E2 = vec3(0.0);     //  box UVs (hive_pt.s sph_graph_ctx)
        vec3 tt, bb;
        onb(ns, tt, bb);
        S_PU = tt * sph_r(t); S_PV = bb * sph_r(t);
        G_VC = has_vcol(t) ? prim_vcol(t, 0.0, 0.0) : vec3(1.0);
        box_uv();
    } else {
    for (int k = 0; k < 3; k++) {
        S_P0[k] = to_[t * 9u + uint(k)]; S_E1[k] = to_[t * 9u + 3u + uint(k)]; S_E2[k] = to_[t * 9u + 6u + uint(k)];
    }
    S_PU = tv3(t, 1u); S_PV = tv3(t, 2u);
    G_VC = tvc[t * 3u] != 0u ? vcol_lin3(t, u, v) : vec3(1.0);     // (none: white)
    if (isnan(tuv[t * 6u])) box_uv();
    else for (int k = 0; k < 3; k++) S_UV[k] = vec2(tuv[t * 6u + uint(2 * k)], tuv[t * 6u + uint(2 * k + 1)]);
    }
    S_HASUV = !isnan(tuv[t * 6u]);
    graph_run(m, u, v, cover, mt, ns, alpha, mask);
}
